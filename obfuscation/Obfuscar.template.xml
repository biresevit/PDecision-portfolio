    <SkipType name="PDecision.ServiceState" skipMethods="true" skipFields="true" skipProperties="true" />
    <!-- Controller.State is PDecision.ServiceState-typed; see failure family 2 above -->
    <SkipType name="PDecision.Controller" skipMethods="true" skipFields="true" skipProperties="true" />
  </Module>

