<?xml version="1.0" encoding="utf-8" ?>
<!-- internalLogFile/internalLogLevel: if the "file" target below can't be created or written to (e.g. no
     permission to create C:/PokerSuite/logs on a given machine), NLog normally fails silently and nothing
     gets logged anywhere. This writes NLog's own diagnostics - including that failure and why - to a
     guaranteed, separate file so a "no log files at all" report can actually be diagnosed. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogFile="${tempdir}/PDecision/nlog-internal.log"
      internalLogLevel="Warn">

  <targets>
    <target name="file" xsi:type="File"
            fileName="C:/PokerSuite/logs/PDecision${shortdate}.log"
            archiveFileName="C:/PokerSuite/archives/PDecision${shortdate}.{##}.log"
            archiveAboveSize="5242880"
            archiveNumbering="Sequence"
            maxArchiveFiles="3" />

  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>

</nlog>
